{
  "name": "bb-plugin-rift",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.84"
  },
  "bb": {
    "name": "Rift",
    "description": "Use independent Rift snapshots as BB thread environments.",
    "branding": {
      "icon": "Copy"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills/rift-environments"
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.53",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.13.7",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "turbo": "^2.8.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tsconfig.runtime.json --test test/*.test.ts",
    "benchmark": "tsx --tsconfig tsconfig.runtime.json benchmarks/workspace.ts"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "author": "aulneau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aulneau/bb-plugin-rift.git"
  },
  "homepage": "https://github.com/aulneau/bb-plugin-rift#readme",
  "bugs": {
    "url": "https://github.com/aulneau/bb-plugin-rift/issues"
  }
}
